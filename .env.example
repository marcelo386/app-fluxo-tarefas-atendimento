# Copie para .env (que o git ignora) e preencha. Nunca coloque valores reais neste arquivo.
AGENT_RUNTIME=github-native
AGENT_DRY_RUN=true
GITHUB_REPO=dono/nome-do-repositorio
# Credencial local do backend: só criar/ler issues deste repositório.
# É diferente do secret COPILOT_AGENT_TOKEN, que fica só nas Actions.
GITHUB_ISSUES_TOKEN=
